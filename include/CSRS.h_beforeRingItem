// SRS 
class CSRS
{
public:
    CSRS(string name);
    virtual ~CSRS();
    void Reset();
    void Initialize();
    string m_name;

    CTreeParameter runtime;
    CTreeParameter eventlength;
    CTreeParameter nHits;
    // CTreeParameter nbEvents;
    CTreeVariable debugMode;

    int nbEvents[MaxFECs];
    int eventNumber[MaxFECs];

    uint64_t timeStampPrev[MaxFECs][MaxVMMs];

    

    // //for testing used in CSRSUnpacker
    // uint64_t fecTimeStampPrev[MaxFECs];


    // SRS(FEC(VMM(adc,tdc...)))
    CSRSFec fec[MaxFECs];


    void SetDataRaw(Gem::ParserSRS::VMM3Data *dataArray);
    void SetDataCal(Gem::ParserSRS::VMM3DataCal *dataCalArray);
    /* void SetDataCal(std::unique_ptr<Gem::ParserSRS::VMM3DataCal[]> dataCalArray); */
    void SetDataParser(Gem::ParserSRS::ParserData pd)
    {
        dataParser = pd;
    };

    Gem::ParserSRS::VMM3Data *GetDataRaw() const
    {
        return dataRaw;
    };
    Gem::ParserSRS::VMM3Data &GetDataRaw(int index) const
    {
        if (dataRaw != nullptr)
        {
            return dataRaw[index];
        }
        throw std::runtime_error("CSRS - dataRaw is null");
    };
    Gem::ParserSRS::ParserData GetDataParser() const
    {
        return dataParser;
    };
    Gem::ParserSRS::VMM3DataCal &GetDataCal(int index) const
    {
        if (dataCal != nullptr)
        {
            return dataCal[index];
        }
        throw std::runtime_error("CSRS - dataCal is null");
    };
    /* VMM3DataCal& GetDataCal(int index) const { */
    /*     if (dataCal != nullptr) { */
    /*         return dataCal[index]; */
    /*     } */
    /*     throw std::runtime_error("CSRS - dataCal is null"); */
    /* }; */

private:
    /* Configuration m_config; */
    Gem::ParserSRS::VMM3Data *dataRaw{nullptr};
    Gem::ParserSRS::VMM3DataCal *dataCal{nullptr};
    Gem::ParserSRS::ParserData dataParser;
};

#endif
