  // std::cout << "size "<<dec << beforeRiBody->size<<" type "<<beforeRiBody->type << std::endl;
  // std::cout << "sizeHeader "<<dec << beforeRiBody->sizeHeader<<" sourceId "<<beforeRiBody->sourceId <<" barrierType "<<beforeRiBody->barrierType<< std::endl;
