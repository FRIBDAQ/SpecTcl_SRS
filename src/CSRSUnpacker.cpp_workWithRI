    // uint32_t sourceIdFrag;
    // uint32_t payloadSizeFrag;
    // uint32_t barrierTypeFrag;
    // uint32_t size;
    // uint32_t type;
    // uint32_t sizeHeader;
    // uint32_t timeStampLower;
    // uint32_t padding; 
    // uint32_t sourceId;
    // uint32_t barrierType;

  // //cast the RI header
  // RIwBH* riH = reinterpret_cast<RIwBH*>(pEvent - 7 * sizeof(uint32_t));
  // //start at padding and shift left by 32 bits
  // timeStamp = static_cast<uint64_t>(riH->padding) << 32;
  // timeStamp |= static_cast<uint64_t>(riH->timeStampLower);

  //remove 4 bytes of inclusive body size (sizeof beforeRiBody->nbBytes)
  // auto size = beforeRiBody->nbBytes - sizeof(beforeRiBody->nbBytes);
 
  // if (datalen != 6)
  // if ((datalen % 6) != 0)
  // std::cout << "size "<< dec << (int)size << " size/56 " << (int)size/56 << " size % 56 " << (int)size % 56 << std::endl;
  // std::cout << "size "<< dec << (int)beforeRiBody->size << " sizeHeader " << (int)beforeRiBody->sizeHeader << " size - sizeHeader " << (int)beforeRiBody->size - (int)beforeRiBody->sizeHeader << " datalen "<< (int)datalen << std::endl;

  // return kfTRUE;

  //body size 4 bytes
  auto datalen = nbBytes - 4;
  //Fragment header 20 bytes + ring item header 8 bytes + ring item body header 20 bytes + ring item body 8 bytes
  if ((datalen % 56) != 0)
  {
    cout << "CSRSUnpacker - Error should have 8 bytes of data, datalen "<<datalen<< " is not a multiple of 56 bytes" << endl;
    return kfFALSE;
  }
  // uint16_t nbHits = datalen / 6;
  uint16_t nbHits = datalen / 56;

  // // With C++14 use unique_ptr and make_unique
  parser = new Gem::ParserSRS(config.maxHits);
  
  
  // // std::cout << "Size " << size << " sizeHeader " << riH->sizeHeader << " size - sizeHeader " << riH->size - riH->sizeHeader << " datalen "<< datalen << " nbHits "<<nbHits << std::endl;
  // // std::cout << "timeStamp " << timeStamp << std::endl;
